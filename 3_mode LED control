#define F_CPU 16000000UL  // CPU 클럭 16MHz 설정
#include <util/delay.h>   // _delay_ms() 함수 사용을 위한 헤더
#include <avr/io.h>       // 레지스터 제어용 AVR 헤더

int main(void)
{
    DDRA = 0xFF;      // PORTA를 출력으로 설정 (LED 연결)
    PORTA = 0x00;     // 초기값: 모든 LED OFF
    DDRB = 0x00;      // PORTB를 입력으로 설정 (스위치 연결)
    PORTB = 0xFF;     // 내부 풀업 저항 활성화 (스위치 미입력시 HIGH)

    while (1)
    {
        unsigned char sw = ~PINB & 0x07;  
        // 스위치 3개만 읽고 논리 반전 (~)하여 눌린 상태가 1로 되게 함
        // ex) 스위치 1,2 눌림 → PINB = 0b11111001 → sw = 0b00000010 | 0b00000001 = 0b00000011

        switch (sw)  // 눌린 스위치 수에 따라 모드 변경
        {
            case 0x01:  // 스위치 1개만 눌렸을 때 (00000001)
            case 0x02:  // 스위치 2만 눌림 (00000010)
            case 0x04:  // 스위치 3만 눌림 (00000100)
                PORTA = 0xFF;  // LED 전부 ON
                break;

            case 0x03:  // 스위치 2개 눌림 (00000011 등)
            case 0x05:  // 스위치 1,3
            case 0x06:  // 스위치 2,3
                PORTA = 0xFF;       // LED ON
                _delay_ms(300);
                PORTA = 0x00;       // LED OFF
                _delay_ms(300);
                break;

            case 0x07:  // 스위치 3개 전부 눌림 (00000111)
                for (int i = 0; i < 8; i++)  // LED 순차 점멸 (왼쪽부터 오른쪽으로)
                {
                    PORTA = (1 << i);  // i번째 비트만 ON
                    _delay_ms(150);
                }
                break;

            default:  // 스위치 안 눌린 경우 등
                PORTA = 0x00;  // LED 전부 OFF
                break;
        }
    }

    return 0;
}
